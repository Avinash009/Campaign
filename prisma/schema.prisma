// CampaignHub database schema
// See docs/DATABASE.md for design rationale, ER diagram and index notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CampaignObjective {
  AWARENESS
  LEAD_GENERATION
  SALES
  APPOINTMENT_BOOKING
  PROMOTION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CtaType {
  ENQUIRE_NOW
  CONTACT_US
  BOOK_APPOINTMENT
  REQUEST_CALLBACK
  GET_QUOTE
  SCHEDULE_VISIT
}

enum CampaignEventType {
  PAGE_VIEW
  FORM_SUBMIT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  CAMPAIGN_PAGE
  DIRECT
  ORGANIC
  SOCIAL
  EMAIL
  REFERRAL
  OTHER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  ASSIGNED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  CONTACT_ATTEMPTED
}

enum NotificationType {
  LEAD_CREATED
  LEAD_ASSIGNED
  CAMPAIGN_PUBLISHED
  CAMPAIGN_COMPLETED
  MEMBER_INVITED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?
  name           String
  phone          String?
  isPlatformAdmin Boolean  @default(false)
  isActive       Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedBusinesses Business[]          @relation("BusinessOwner")
  invitedMembers   BusinessMember[]   @relation("MemberInviter")
  memberships      BusinessMember[]
  campaignsCreated Campaign[]
  assignedLeads    Lead[]             @relation("LeadAssignee")
  leadActivities   LeadActivity[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  accounts Account[]
  sessions Session[]
}

// Auth.js tables — reserved for future OAuth / email verification flows.
// JWT sessions are used today, so these are unused but schema-ready.

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Industries (tenant-shared catalog)
// ---------------------------------------------------------------------------

model Industry {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  iconKey     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses Business[]
  campaigns  Campaign[]

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Businesses (tenants)
// ---------------------------------------------------------------------------

model Business {
  id                   String          @id @default(uuid())
  name                 String
  slug                 String          @unique
  email                String
  phone                String?
  website              String?
  industryId           String?
  ownerId              String
  city                 String?
  state                String?
  country              String?
  description          String?
  logoUrl              String?
  status               BusinessStatus  @default(ACTIVE)
  onboardingCompletedAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  owner         User           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  industry      Industry?      @relation(fields: [industryId], references: [id], onDelete: SetNull)
  members       BusinessMember[]
  campaigns     Campaign[]
  leads         Lead[]
  subscription  Subscription?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([industryId])
  @@index([status])
}

model BusinessMember {
  id              String       @id @default(uuid())
  businessId      String
  role            UserRole     @default(MEMBER)
  status          MemberStatus @default(ACTIVE)
  userId          String?
  invitationEmail String?
  invitationToken String?      @unique
  invitedById     String?
  invitedAt       DateTime?
  invitationExpiresAt DateTime?
  joinedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy  User?    @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([invitationEmail])
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String?
  currency    String       @default("INR")
  amount      Int // minor units (paise)
  interval    PlanInterval @default(MONTHLY)
  campaignLimit Int? // null = unlimited
  memberLimit   Int?
  features    Json
  isActive    Boolean      @default(true)
  isFeatured  Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                String             @id @default(uuid())
  businessId        String             @unique
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id            String            @id @default(uuid())
  businessId    String
  industryId    String?
  createdById   String
  name          String
  slug          String            @unique
  description   String?
  objective     CampaignObjective @default(LEAD_GENERATION)
  status        CampaignStatus    @default(DRAFT)
  startDate     DateTime?
  endDate       DateTime?

  // Promotional content
  headline        String?
  promoDescription String?
  productDetails  String?
  offerDetails    String?
  currency        String?
  price           Int? // minor units (paise)
  priceDisplay    String? // free text for ranges, e.g. "₹85 Lakhs onwards"
  ctaType         CtaType     @default(ENQUIRE_NOW)
  videoUrl        String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?

  // Targeting
  targetLocation  String?
  targetAudience  String?
  ageRangeMin     Int?
  ageRangeMax     Int?
  interests       String[]

  // Lifecycle
  publishedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  industry   Industry?       @relation(fields: [industryId], references: [id], onDelete: SetNull)
  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  images     CampaignImage[]
  events     CampaignEvent[]
  leads      Lead[]

  @@index([businessId, status])
  @@index([industryId])
  @@index([status, publishedAt])
}

model CampaignImage {
  id         String   @id @default(uuid())
  campaignId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

/// Append-only analytics events for campaign landing pages.
model CampaignEvent {
  id         String             @id @default(uuid())
  campaignId String
  type       CampaignEventType
  visitorId  String
  referrer   String?
  userAgent  String?
  ipAddress  String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  utmTerm    String?
  utmContent String?
  occurredAt DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([campaignId, type, occurredAt])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id          String     @id @default(uuid())
  businessId  String
  campaignId  String?
  name        String
  email       String?
  phone       String
  city        String?
  interestedIn String?
  message     String?
  metadata    Json? // industry-specific structured answers
  source      LeadSource @default(CAMPAIGN_PAGE)
  status      LeadStatus @default(NEW)
  assignedToId String?
  consentGiven Boolean   @default(false)
  consentText  String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  visitorId    String?
  referrer     String?
  ipAddress    String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  lostAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities LeadActivity[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([campaignId, createdAt])
  @@index([assignedToId, status])
  @@index([businessId, phone, createdAt])
  @@index([phone])
}

model LeadActivity {
  id           String           @id @default(uuid())
  leadId       String
  actorId      String?
  type         LeadActivityType
  fromStatus   LeadStatus?
  toStatus     LeadStatus?
  note         String?
  scheduledFor DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications, audit, rate limiting
// ---------------------------------------------------------------------------

model Notification {
  id         String             @id @default(uuid())
  userId     String
  businessId String?
  type       NotificationType
  title      String
  body       String?
  linkUrl    String?
  isRead     Boolean            @default(false)
  readAt     DateTime?
  createdAt  DateTime           @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([businessId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  businessId String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Sliding-window rate limit counters for public endpoints.
model RateLimitLog {
  id        String   @id @default(uuid())
  key       String // "{scope}:{identifier}"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
